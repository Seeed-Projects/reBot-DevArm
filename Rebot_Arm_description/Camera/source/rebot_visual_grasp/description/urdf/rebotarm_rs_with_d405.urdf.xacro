<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebotarm_rs_d405">
  <xacro:arg name="with_camera" default="true"/>
  <xacro:arg name="use_nominal_extrinsics" default="true"/>
  <xacro:include filename="$(find rebotarm_bringup)/description/RS/urdf/ReBot_Arm_RS.urdf"/>
  <xacro:if value="$(arg with_camera)">
    <xacro:include filename="$(find realsense2_description)/urdf/_d405.urdf.xacro"/>
  </xacro:if>

  <!--
    Mount mesh: description/meshes/D405_305_Mount.stl (from D405_305_Mount.step, mm → scale 0.001).
    Frame chain: gripper_end -> camera_mount_link -> camera_bottom_screw_frame -> camera_link

    D405 uses its own mount CAD (not Gemini2's D435_Gemini2_Mount).
    mount_* / camera_* are D405-only — do not sync from Gemini2.
  -->
  <xacro:property name="mount_xyz" value="-0.1201 0.0003 0.0507"/>
  <xacro:property name="mount_rpy" value="1.5827 0.0024 1.5515"/>
  <xacro:property name="mount_mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="camera_xyz" value="-0.0003 0.0443 -0.0093"/>
  <xacro:property name="camera_rpy" value="-0.0225 -1.0448 -1.5460"/>

  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rebot_visual_grasp/description/meshes/D405_305_Mount.stl"
              scale="${mount_mesh_scale}"/>
      </geometry>
    </visual>
  </link>

  <joint name="gripper_to_mount" type="fixed">
    <parent link="gripper_end"/>
    <child link="camera_mount_link"/>
    <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
  </joint>

  <xacro:if value="$(arg with_camera)">
    <!-- sensor_d405 origin is the camera bottom screw frame -->
    <xacro:sensor_d405
        parent="camera_mount_link"
        name="camera"
        use_nominal_extrinsics="$(arg use_nominal_extrinsics)">
      <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
    </xacro:sensor_d405>
  </xacro:if>
</robot>
