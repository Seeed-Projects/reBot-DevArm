<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rebotarm_rs_uvc32">
  <!--Official STEP bracket; generic board/lens are schematic, not calibrated.-->
  <link name="gripper_end" />
  <link name="camera_mount_link">
    <visual>
      <geometry>
        <mesh filename="package://uvc32_description/meshes/mounts/UVC32_mount.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="camera_mount_link_uvc32_1">
        <color rgba="0.7 0.73 0.75 1" />
      </material>
    </visual>
  </link>
  <joint name="gripper_to_mount" type="fixed">
    <parent link="gripper_end" />
    <child link="camera_mount_link" />
    <origin xyz="-0.0940591902018 -0.000253569288831 0.0299718222073" rpy="1.5827 0.0024 1.5515" />
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://uvc32_description/meshes/uvc32/board.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="camera_link_uvc32_1">
        <color rgba="0.06 0.32 0.14 1" />
      </material>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://uvc32_description/meshes/uvc32/lens.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="camera_link_uvc32_2">
        <color rgba="0.035 0.035 0.04 1" />
      </material>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://uvc32_description/meshes/uvc32/glass.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="camera_link_uvc32_3">
        <color rgba="0.04 0.14 0.22 1" />
      </material>
    </visual>
  </link>
  <joint name="mount_to_camera" type="fixed">
    <parent link="camera_mount_link" />
    <child link="camera_link" />
    <origin xyz="1.4555e-06 0.07507025725 -0.0274030491" rpy="-0.60145585568 0 3.14159265359" />
  </joint>
  <link name="camera_color_frame" />
  <joint name="camera_color_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_color_frame" />
    <origin xyz="0 0 0.0099" rpy="0 0 0" />
  </joint>
  <link name="camera_color_optical_frame" />
  <joint name="camera_color_optical_joint" type="fixed">
    <parent link="camera_color_frame" />
    <child link="camera_color_optical_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
