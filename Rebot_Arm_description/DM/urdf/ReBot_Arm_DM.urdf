      <origin xyz="-0.06977348246 0.008873565107 0.003629107093" rpy="0 0 0" />
      <mass value="0.0559" />
      <inertia ixx="2.840092016e-05" ixy="-3.744740801e-06" ixz="3.109543825e-06" iyy="2.038803338e-05" iyz="4.00238964e-06" izz="3.431763831e-05" />
