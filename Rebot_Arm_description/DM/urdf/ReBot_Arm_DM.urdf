  <!-- Each finger uses a measured 12.0 g printed body and 43.9 g hardware group.
       Centers of mass and tensors are estimated from their visual meshes with uniform
       density within each weighed group. The hardware group covers the moving
       carriage, travel stop and crossed rack. -->
  <link name="finger_left_link">
